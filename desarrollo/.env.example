# Config de conexión a ROBLE que lee la app (lib/core/roble_config.dart) vía
# String.fromEnvironment. Ninguno de los dos valores es secreto (el
# contractId identifica el proyecto, no da acceso), así que este .example
# lleva los reales; solo faltaría si apuntas a otro proyecto ROBLE.
#
# Cópialo como `.env` (ya está en .gitignore) y corre:
#   flutter run --dart-define-from-file=.env

ROBLE_BASE_URL=https://roble-api.test-openlab.uninorte.edu.co
ROBLE_CONTRACT_ID=
